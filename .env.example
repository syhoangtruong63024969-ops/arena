# Public, non-secret storefront settings. VITE_* values are visible to visitors.
VITE_PLAN_PRICE_VND=49000
# Optional HTTPS checkout URL from your payment provider. Leave empty for local drafts.
# Configure the product, price and fulfillment on the provider before adding its URL.
VITE_CHECKOUT_URL=
# Optional public customer-support email.
VITE_SUPPORT_EMAIL=
# For GitHub Pages: BASE_PATH=/arena/ (set in the included Pages workflow)
# NEVER add an ElevenLabs API key to a VITE_* variable or to frontend code.
